# Generated outputs - rebuilt deterministically from data/matches plus the live API,
# so committing them would only create merge noise between the PC and the cloud run.
output/
logs/

# Derived state, regenerated every run.
data/season_*.json
data/fixtures.json
data/fixture_history.json
data/schedule_status.json
data/fetch_status.json
data/last_run.json
data/last_delta.json
data/notification.json
data/fallback_transfermarkt.json
data/verify_status.json
data/changelog.md

# Tracked on purpose: data/matches/*.json - the raw per-match records, named by game id.
# Mostly append-only: two writers normally add distinct files and never collide. The one
# exception is the 48h after kickoff, during which a record can still be rewritten to add
# player ratings 365scores had not published at the whistle (see RATING_RETRY_HOURS in
# scripts/hta_fetch.py). A push racing another writer inside that window can therefore need
# a rebase, which the cloud routine is told to do once before reporting failure.

__pycache__/
*.pyc
.venv/
